{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phrase Strings API Reference Accounts Formats API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Formats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List formats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phrase.com/v2/formats"
          },
          "docs": "Get a handy list of all localization file formats supported in Phrase."
        }
      ]
    }
  ],
  "bundled": true
}