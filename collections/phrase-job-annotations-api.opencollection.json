                "description": "Branch to use"
              },
              {
                "name": "job_id",
                "value": "",
                "type": "path",
                "description": "Job ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Name of the annotation to delete."
              }
            ]
          },
          "docs": "Delete an annotation for a job."
        },
