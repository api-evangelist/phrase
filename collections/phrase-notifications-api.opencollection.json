{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phrase Strings API Reference Accounts Notifications API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phrase.com/v2/notifications",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "25",
                "type": "query",
                "description": "Limit on the number of objects to be returned, between 1 and 100. 25 by default"
              },
              {
                "name": "unseen",
                "value": "true",
                "type": "query",
                "description": "Include only unseen notifications"
              }
            ]
          },
          "docs": "List all notifications from the current user"
        },
        {
          "info": {
            "name": "Mark all notifications as read",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.phrase.com/v2/notifications/mark_all_as_read",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ]
          },
          "docs": "Mark all notifications of the current user as read"
        },
        {
          "info": {
            "name": "Get a single notification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phrase.com/v2/notifications/:id",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID"
              }
            ]
          },
          "docs": "Get details on a single notification."
        }
      ]
    }
  ],
  "bundled": true
}