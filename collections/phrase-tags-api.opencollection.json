{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phrase Strings API Reference Accounts Tags API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phrase.com/v2/projects/:project_id/tags",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "25",
                "type": "query",
                "description": "Limit on the number of objects to be returned, between 1 and 100. 25 by default"
              },
              {
                "name": "exclude_system_tags",
                "value": "true",
                "type": "query",
                "description": "excludes tags generated by the system, e.g. job, upload or figma tags"
              },
              {
                "name": "branch",
                "value": "my-feature-branch",
                "type": "query",
                "description": "specify the branch to use"
              }
            ]
          },
          "docs": "List all tags for the given project."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.phrase.com/v2/projects/:project_id/tags",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new tag."
        },
        {
          "info": {
            "name": "Get a single tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phrase.com/v2/projects/:project_id/tags/:name",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "name"
              },
              {
                "name": "omit_statistics",
                "value": "true",
                "type": "query",
                "description": "omit statistics in the response"
              },
              {
                "name": "branch",
                "value": "my-feature-branch",
                "type": "query",
                "description": "specify the branch to use"
              }
            ]
          },
          "docs": "Get details and progress information on a single tag for a given project."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.phrase.com/v2/projects/:project_id/tags/:name",
            "headers": [
              {
                "name": "X-PhraseApp-OTP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "name"
              },
              {
                "name": "branch",
                "value": "my-feature-branch",
                "type": "query",
                "description": "specify the branch to use"
              }
            ]
          },
          "docs": "Delete an existing tag."
        }
      ]
    }
  ],
  "bundled": true
}